{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build --workspace=@workspace/campus-bus",
    "start": "NODE_ENV=production tsx server.ts",
    "typecheck": "tsc -p artifacts/campus-bus/tsconfig.json --noEmit",
    "lint": "tsc -p artifacts/campus-bus/tsconfig.json --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "firebase": "^13.0.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vite": "^6.0.0"
  }
}
